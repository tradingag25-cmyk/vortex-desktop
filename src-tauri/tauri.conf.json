{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vortex",
  "version": "1.0.6",
  "identifier": "com.vortexsgi.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vortex — Sistema de Gestión Integral",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 660,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
