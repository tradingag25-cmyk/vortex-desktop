{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vortex",
  "version": "1.4.8",
  "identifier": "com.vortexsgi.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vortex — Sistema de Gestión Integral",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 660,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/tradingag25-cmyk/vortex-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4RUQ4NTRENjM2RTI0RDUKUldUVkpHNWpUWVh0bUhPQlA1ZVdjZXdubmR4Ym1USk9GMkdMbjJCOGJid2lKT3FjaFN5VUw3UWYK"
    }
  }
}
